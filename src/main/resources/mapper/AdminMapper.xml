<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.scb.tb.askopt_backend.mapper.AdminMapper">

    <!-- 定义结果映射：处理用户+角色一对多关系 -->
    <resultMap id="UserWithRolesResultMap" type="com.scb.tb.askopt_backend.vo.UserWithRolesVO">
        <!-- 用户基础字段映射 -->
        <id column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="enabled" property="enabled"/>

        <!-- 一对多映射：角色列表 -->
        <collection property="roles" ofType="com.scb.tb.askopt_backend.vo.UserWithRolesVO$RoleVO">
            <id column="role_id" property="roleId"/>
            <result column="role_name" property="roleName"/>
        </collection>
    </resultMap>

    <!-- 查询所有用户+角色SQL -->
    <select id="selectUsersWithRoles" resultMap="UserWithRolesResultMap">
        SELECT
        u.id AS user_id,
        u.username,
        u.enabled,
        r.id AS role_id,
        r.role_name
        FROM sys_user u
        LEFT JOIN user_role_mapping urm ON u.id = urm.user_id
        LEFT JOIN sys_role r ON urm.role_id = r.id
        ORDER BY u.id
    </select>
</mapper>