<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.scb.askopt_backend.mapper.PermissionMapper">

    <!-- resolve incoming path+method to a single permission_code
         mechanism: convert stored pattern's '*' to SQL '%' and match: #{path} LIKE REPLACE(url_pattern,'*','%')
         prefer most specific (longest) pattern -->
    <select id="findPermissionCodeByUrlAndMethod" resultType="string" parameterType="map">
        SELECT permission_code
        FROM sys_permission
        WHERE #{path} LIKE REPLACE(url_pattern, '*', '%')
          AND (http_method = #{method} OR http_method = '*')
        ORDER BY CHAR_LENGTH(url_pattern) DESC
        LIMIT 1
    </select>

    <!-- count if any of the provided role codes grant the permission_code -->
    <select id="countRolePermissionByRoleCodesAndPermissionCode" resultType="int" parameterType="map">
        SELECT COUNT(1)
        FROM sys_role r
        JOIN sys_role_permission rp ON r.id = rp.role_id
        JOIN sys_permission p ON p.id = rp.permission_id
        WHERE r.role_code IN
        <foreach item="code" collection="roleCodes" open="(" separator="," close=")">
            #{code}
        </foreach>
          AND p.permission_code = #{permissionCode}
    </select>
    <!-- Mapper XML: PermissionMapper.xml -->
    <select id="findCodesByRoleCodes" resultType="java.lang.String" parameterType="java.util.List">
        SELECT DISTINCT p.permission_code
        FROM sys_role_permission rp
        JOIN sys_permission p ON rp.permission_code = p.permission_code
        <where>
            <if test="roles != null and roles.size() &gt; 0">
                rp.role_code IN
                <foreach collection="roles" item="role" open="(" separator="," close=")">
                    #{role}
                </foreach>
            </if>
        </where>
    </select>


</mapper>

